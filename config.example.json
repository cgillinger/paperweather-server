{
  "_comment": "paperweather-server example config. Copy to config.json and edit. JSON has no comments, so fields starting with _comment are ignored notes. config.json holds your settings and keys: never commit it.",
  "_comment_fonts": "Typsnitt i relativ sökväg för portabilitet",
  "_comment_provider": "weather_provider: 'smhi' = SMHI (Sweden only, the default and best tested) or 'yr' = MET Norway/Yr (global). Observations (smhi_observations) are always SMHI and only meaningful in Sweden.",
  "weather_provider": "smhi",
  "_comment_location": "Replace with your own place. name is shown on the display. Use decimal degrees (negative = south/west).",
  "location": {
    "name": "Stockholm",
    "latitude": 59.3293,
    "longitude": 18.0686
  },
  "_comment_smhi_observations": "Pick the nearest SMHI observation station (used for 'has it rained in the last hour'). See smhi_stationer.md for ready-made station ids per city and smhi_stationer_instruktion.md for how to find one. The fallback station is used if the primary has no data. The primary_station_name is also shown in the status box when Netatmo is not configured.",
  "smhi_observations": {
    "primary_station_id": "98230",
    "primary_station_name": "Stockholm-Observatoriekullen A",
    "fallback_station_id": "97390",
    "fallback_station_name": "Stockholm-Arlanda"
  },
  "_comment_api_keys": "Everything under api_keys is optional. netatmo: leave client_id/client_secret/refresh_token empty and Netatmo is disabled (SMHI-only mode); to enable, create an app at https://dev.netatmo.com and fill in all three. ipgeolocation: optional key from https://ipgeolocation.io; leave empty and sunrise/sunset is calculated locally (accurate to about a minute).",
  "api_keys": {
    "netatmo": {
      "client_id": "",
      "client_secret": "",
      "refresh_token": ""
    },
    "ipgeolocation": ""
  },
  "layout": {
    "type": "focus_a",
    "screen_width": 800,
    "screen_height": 480,
    "margin": 40,
    "module_spacing": 20
  },
  "module_groups": {
    "bottom_section": {
      "normal": [
        "clock_module",
        "status_module"
      ],
      "precipitation_active": [
        "precipitation_module"
      ]
    },
    "hero_section": {
      "normal": [
        "main_weather"
      ]
    },
    "forecast_section": {
      "normal": [
        "tomorrow_forecast"
      ]
    },
    "medium_right_section": {
      "normal": [
        "barometer_module"
      ],
      "wind_active": [
        "wind_module"
      ]
    }
  },
  "triggers": {
    "precipitation_trigger": {
      "condition": "precipitation > 0 OR (forecast_precipitation_2h >= 0.2 AND (pcat == 2 OR pcat == 3 OR pcat == 5))",
      "target_section": "bottom_section",
      "activate_group": "precipitation_active",
      "priority": 100
    },
    "wind_trigger": {
      "condition": "wind_speed > 6.0",
      "target_section": "medium_right_section",
      "activate_group": "wind_active",
      "priority": 80
    }
  },
  "modules": {
    "main_weather": {
      "enabled": true,
      "position": "hero",
      "size": {
        "width": 480,
        "height": 300
      },
      "coords": {
        "x": 40,
        "y": 40
      },
      "data_sources": [
        "netatmo",
        "smhi",
        "smhi_observations"
      ]
    },
    "barometer_module": {
      "enabled": true,
      "position": "medium_1",
      "size": {
        "width": 240,
        "height": 200
      },
      "coords": {
        "x": 540,
        "y": 40
      },
      "data_sources": [
        "netatmo"
      ]
    },
    "wind_module": {
      "enabled": false,
      "position": "medium_1",
      "size": {
        "width": 240,
        "height": 200
      },
      "coords": {
        "x": 540,
        "y": 40
      },
      "data_sources": [
        "smhi"
      ]
    },
    "tomorrow_forecast": {
      "enabled": true,
      "position": "medium_2",
      "size": {
        "width": 240,
        "height": 200
      },
      "coords": {
        "x": 540,
        "y": 260
      },
      "data_sources": [
        "smhi"
      ]
    },
    "clock_module": {
      "enabled": true,
      "position": "small_1",
      "size": {
        "width": 240,
        "height": 100
      },
      "coords": {
        "x": 40,
        "y": 360
      },
      "data_sources": [
        "local"
      ]
    },
    "status_module": {
      "enabled": true,
      "position": "small_2",
      "size": {
        "width": 240,
        "height": 100
      },
      "coords": {
        "x": 280,
        "y": 360
      },
      "data_sources": [
        "local"
      ]
    },
    "precipitation_module": {
      "enabled": true,
      "position": "dynamic_bottom",
      "size": {
        "width": 480,
        "height": 100
      },
      "coords": {
        "x": 40,
        "y": 360
      },
      "data_sources": [
        "smhi",
        "smhi_observations",
        "cycling_weather"
      ]
    }
  },
  "update_intervals": {
    "netatmo_seconds": 600,
    "smhi_seconds": 1800,
    "smhi_observations_seconds": 900,
    "display_seconds": 300,
    "clock_seconds": 60
  },
  "display": {
    "type": "generic_800x480",
    "rotation": 0,
    "invert_colors": false,
    "_comment_font_path": "FLEXIBEL SÖKVÄG - main_web.py söker automatiskt i flera platser",
    "font_path": "./fonts/DejaVuSans.ttf",
    "font_scale": 1.0
  },
  "fonts": {
    "hero_temp": 72,
    "hero_desc": 32,
    "medium_main": 48,
    "medium_desc": 24,
    "small_main": 32,
    "small_desc": 18,
    "tiny": 14
  },
  "user_preferences": {
    "module_preference": "normal"
  },
  "debug": {
    "enabled": false,
    "log_level": "INFO",
    "save_images": false,
    "test_mode": false,
    "allow_test_data": false,
    "test_timeout_hours": 1
  }
}
